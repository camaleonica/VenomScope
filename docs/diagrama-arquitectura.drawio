<mxfile host="app.diagrams.net" agent="VenomScope" type="device">
  <diagram id="venomscope-arquitectura" name="Arquitectura">
    <mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="titulo" value="VenomScope &#8212; c&#243;mo se integra la IA en el producto" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#18181B;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitulo" value="Qu&#233; entra, qu&#233; decide el sistema y qu&#233; ve la persona" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#52525B;" vertex="1" parent="1">
          <mxGeometry x="40" y="44" width="800" height="20" as="geometry" />
        </mxCell>

        <mxCell id="legIA" value="Inteligencia artificial" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3987E5;strokeWidth=2;fontSize=12;fontColor=#18181B;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="200" height="28" as="geometry" />
        </mxCell>
        <mxCell id="legRegla" value="Regla escrita a mano" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FDEBE0;strokeColor=#D95926;strokeWidth=2;fontSize=12;fontColor=#18181B;" vertex="1" parent="1">
          <mxGeometry x="256" y="78" width="200" height="28" as="geometry" />
        </mxCell>
        <mxCell id="legDato" value="Dato guardado" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#52525B;fontSize=12;fontColor=#18181B;" vertex="1" parent="1">
          <mxGeometry x="472" y="78" width="200" height="28" as="geometry" />
        </mxCell>

        <mxCell id="entrada" value="&lt;b&gt;Secuencia de amino&#225;cidos&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52525B&quot;&gt;pegada a mano, o un archivo FASTA o CSV con la campa&#241;a entera&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#18181B;fontSize=13;fontColor=#18181B;" vertex="1" parent="1">
          <mxGeometry x="320" y="140" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="sistema" value="LO QUE HACE EL SISTEMA" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#A1A1AA;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontColor=#71717A;" vertex="1" parent="1">
          <mxGeometry x="300" y="230" width="480" height="390" as="geometry" />
        </mxCell>
        <mxCell id="step1" value="&lt;b&gt;1 &#183; Revisar la secuencia&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52525B&quot;&gt;20 letras v&#225;lidas, largo 5 a 600; si no, avisa y no inventa&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDEBE0;strokeColor=#D95926;strokeWidth=2;fontSize=13;fontColor=#18181B;" vertex="1" parent="1">
          <mxGeometry x="320" y="268" width="440" height="56" as="geometry" />
        </mxCell>
        <mxCell id="step2" value="&lt;b&gt;2 &#183; Traducir a n&#250;meros con ESM-2&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52525B&quot;&gt;480 n&#250;meros por secuencia; corre en CPU, sin internet&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3987E5;strokeWidth=2;fontSize=13;fontColor=#18181B;" vertex="1" parent="1">
          <mxGeometry x="320" y="348" width="440" height="56" as="geometry" />
        </mxCell>
        <mxCell id="step3" value="&lt;b&gt;3 &#183; Reconocer la familia&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52525B&quot;&gt;la m&#225;s parecida de las 24 que conoce, con su nivel de confianza&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3987E5;strokeWidth=2;fontSize=13;fontColor=#18181B;" vertex="1" parent="1">
          <mxGeometry x="320" y="428" width="210" height="76" as="geometry" />
        </mxCell>
        <mxCell id="step4" value="&lt;b&gt;4 &#183; Medir la novedad&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52525B&quot;&gt;qu&#233; tan lejos est&#225; del cat&#225;logo: 0 a 100 y los 5 vecinos&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3987E5;strokeWidth=2;fontSize=13;fontColor=#18181B;" vertex="1" parent="1">
          <mxGeometry x="550" y="428" width="210" height="76" as="geometry" />
        </mxCell>
        <mxCell id="step5" value="&lt;b&gt;5 &#183; Decidir la prioridad&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52525B&quot;&gt;reglas expl&#237;citas; combina novedad, confianza y si es del NEA&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDEBE0;strokeColor=#D95926;strokeWidth=2;fontSize=13;fontColor=#18181B;" vertex="1" parent="1">
          <mxGeometry x="320" y="534" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="datos" value="LO QUE YA SABE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#A1A1AA;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontColor=#71717A;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="220" height="220" as="geometry" />
        </mxCell>
        <mxCell id="catalogo" value="&lt;b&gt;Cat&#225;logo&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52525B&quot;&gt;584 toxinas de 106 especies&lt;br&gt;fuente: UniProt&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#52525B;fontSize=13;fontColor=#18181B;" vertex="1" parent="1">
          <mxGeometry x="60" y="434" width="180" height="76" as="geometry" />
        </mxCell>
        <mxCell id="umbrales" value="&lt;b&gt;Umbrales&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52525B&quot;&gt;novedad: 75 y 90&lt;br&gt;ajustables desde la pantalla&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#52525B;fontSize=13;fontColor=#18181B;" vertex="1" parent="1">
          <mxGeometry x="60" y="526" width="180" height="76" as="geometry" />
