        <mxCell id="out2" value="Novedad de 0 a 100 y los 5 vecinos m&#225;s parecidos" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#18181B;" vertex="1" parent="1">
          <mxGeometry x="64" y="716" width="320" height="24" as="geometry" />
