        <mxCell id="salida" value="LO QUE VE LA PERSONA" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#A1A1AA;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontColor=#71717A;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="1020" height="120" as="geometry" />
