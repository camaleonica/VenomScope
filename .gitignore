# Entorno virtual (cada una lo crea con requirements.txt)
.venv/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Artefactos pesados: se regeneran con scripts/construir_artefactos.py o vienen del notebook.
# El catálogo (CSV) sí se versiona: es chico y es la fuente de todo.
artifacts/*.npy
artifacts/*.joblib

# macOS
.DS_Store
/venv

# Lo que el laboratorio confirma desde la app: estado local, no codigo.
# Se borra desde la propia pantalla con "Vaciar todo".
datos/

# Capturas de pantalla sueltas en la raiz: salen de probar la app y no son del
# proyecto. Las de la interfaz van en assets/img/, que se versiona aparte.
/*.png

# Registros de ejecucion (preparar_demo.log y companania).
*.log
